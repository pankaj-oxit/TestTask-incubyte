# Host-only: from repo root — make run / make migrate (Postgres on localhost:5432)
DATABASE_URL=postgresql://postgres:password@localhost:5432/acme_salary
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set false locally if you do not want API startup to insert 10k rows when DB is empty
AUTO_SEED_ON_STARTUP=true
